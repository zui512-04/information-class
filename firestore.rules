rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validPost() {
      return request.resource.data.keys().hasOnly([
          'type', 'title', 'content', 'category', 'anonymous',
          'authorName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.type in ['note', 'question', 'post']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 90
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.anonymous is bool
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 40;
    }

    match /usernames/{username} {
      // Used by registration to check username uniqueness. Only the UID is stored here.
      allow read: if true;
      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && verifiedUser()
        && request.resource.data.keys().hasOnly(['username', 'role', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']));
      allow delete: if isAdmin();

      match /myPosts/{postId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && verifiedUser()
          && request.resource.data.keys().hasOnly(['postId', 'createdAt'])
          && request.resource.data.postId == postId;
        allow update: if isSelf(uid) || isAdmin();
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if verifiedUser()
        && validPost()
        && getAfter(/databases/$(database)/documents/postPrivate/$(postId)).data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || (verifiedUser()
          && get(/databases/$(database)/documents/postPrivate/$(postId)).data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'content', 'category', 'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 90
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 5000
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 40);
      allow delete: if isAdmin()
        || (verifiedUser()
          && get(/databases/$(database)/documents/postPrivate/$(postId)).data.authorUid == request.auth.uid);

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if verifiedUser() && isSelf(uid)
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if verifiedUser() && isSelf(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if verifiedUser()
          && request.resource.data.keys().hasOnly(['content', 'anonymous', 'authorName', 'createdAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.anonymous is bool
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 40;
        allow update, delete: if isAdmin();
      }
    }

    match /postPrivate/{postId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly(['authorUid', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/posts/$(postId)).data.type in ['note', 'question', 'post'];
      allow update: if false;
      allow delete: if isAdmin()
        || (verifiedUser() && resource.data.authorUid == request.auth.uid);
    }

    // Admins may inspect reports and logs. These collections remain inaccessible to ordinary users.
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if verifiedUser();
    }

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
