rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedUser() { return signedIn() && request.auth.token.email_verified == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function ownsPost(postId) {
      return signedIn()
        && exists(/databases/$(database)/documents/postPrivate/$(postId))
        && get(/databases/$(database)/documents/postPrivate/$(postId)).data.authorUid == request.auth.uid;
    }
    function validPost() {
      return request.resource.data.keys().hasOnly(['type','title','content','category','anonymous','authorName','createdAt','updatedAt'])
        && request.resource.data.type in ['note','question','post']
        && request.resource.data.title is string && request.resource.data.title.size() <= 90
        && request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 5000
        && request.resource.data.category is string && request.resource.data.category.size() <= 40
        && request.resource.data.anonymous is bool
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 40;
    }
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['username','role','createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (isSelf(uid) && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']));
      allow delete: if isAdmin();
      match /myPosts/{postId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) && verifiedUser()
          && request.resource.data.keys().hasOnly(['postId','createdAt']) && request.resource.data.postId == postId;
        allow update: if isAdmin() || (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postId','createdAt'])
          && request.resource.data.postId == postId);
        allow delete: if isSelf(uid) || isAdmin();
      }
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if verifiedUser() && validPost()
        && getAfter(/databases/$(database)/documents/postPrivate/$(postId)).data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || (verifiedUser() && ownsPost(postId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','content','category','updatedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 90
          && request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 5000
          && request.resource.data.category is string && request.resource.data.category.size() <= 40);
      allow delete: if isAdmin() || (verifiedUser() && ownsPost(postId));
      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if verifiedUser() && isSelf(uid) && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if isAdmin() || (verifiedUser() && isSelf(uid));
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if verifiedUser()
          && request.resource.data.keys().hasOnly(['content','anonymous','authorName','createdAt'])
          && request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000
          && request.resource.data.anonymous is bool && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 40;
        allow update, delete: if isAdmin();
      }
    }
    match /postPrivate/{postId} {
      allow read: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly(['authorUid','createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/posts/$(postId)).data.type in ['note','question','post'];
      allow update: if false;
      allow delete: if isAdmin() || (verifiedUser() && resource.data.authorUid == request.auth.uid);
    }
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if verifiedUser()
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['postId','postTitle','reporterUid','reporterName','reason','details','status','createdAt'])
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && request.resource.data.postTitle is string && request.resource.data.postTitle.size() <= 90
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterName is string && request.resource.data.reporterName.size() <= 40
        && request.resource.data.reason in ['不當或攻擊性內容','騷擾或霸凌','個人資料／隱私','垃圾訊息或廣告','其他']
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'pending';
    }
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actorUid','actorName','action','targetId','details','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string && request.resource.data.action.size() <= 80
        && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() <= 500;
      allow update, delete: if false;
    }
  }
}